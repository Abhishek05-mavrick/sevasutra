# Sahayak (PS 26) — Environment Configuration Template
# Copy to .env and fill in the services you are enabling.
# No secrets are required to run the deterministic engine or local unit tests.

# --- Core API & Database ---
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://user:password@localhost:5432/sahayak
REDIS_URL=redis://localhost:6379

# --- Phase 1: Phone OTP (India TRAI DLT Compliant) ---
# Supported adapters: msg91 | gupshup | twilio | aws_sns
OTP_PROVIDER=
OTP_API_KEY=
OTP_SENDER_ID=
DLT_ENTITY_ID=
DLT_TEMPLATE_ID=

# --- Phase 1: Google Identity Services (OIDC — Explorer Sign-In Only) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Phase 2: Encrypted Object Storage & OCR ---
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KMS_KEY_ID=
OCR_PROVIDER=
OCR_API_KEY=

# --- Phase 7: Grounded Explanation LLM & Translation (Never decides eligibility) ---
LLM_PROVIDER=
LLM_API_KEY=
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# --- Phase 8: Email Reminders ---
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Phase 6 & 14: Authorised Government APIs (Only after partner approval) ---
API_SETU_CLIENT_ID=
API_SETU_API_KEY=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
MYSCHEME_PARTNER_KEY=
